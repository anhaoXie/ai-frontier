# ---------------------------------------------------------------
# 采集产出：每次运行都会新增文件，不进版本库。
#
# 为什么忽略：这些是本机跑出来的产物（候选 JSON 每天几百 KB、
# Excel、日报、日志），对别人没有意义，而且会让仓库迅速膨胀。
# 想看当天结果，跑一次 run.cmd collect 就有了。
# ---------------------------------------------------------------
out/candidates/*
out/digests/*
out/logs/*
out/reports/*
!out/**/.gitkeep

# 历史状态：记录过去 30 天"已见过"的条目，用来算"首次出现"分数。
# 删掉不会出错，只是所有条目都会被当成新的。
data/state.json

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------
# 本机/编辑器相关
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 万一有人在这里放密钥，别提交上去
.env
.env.local
*.pem
